# Backend Express Server Configuration
PORT=5000

# PostgreSQL Database Connection URL (Drizzle ORM & pg pool)
DATABASE_URL=postgresql://user:password@localhost:5432/hippohealth

# Authentication & JWT Configuration
JWT_SECRET=your_jwt_secret_key_here

# OpenAI / Groq AI Agent SDK Configuration
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b

# Cloudflare R2 Storage Bucket Configuration
R2_BUCKET=onbillo
R2_PUBLIC_URL=https://pub-yourdomain.r2.dev
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_TOKEN_VALUE=your_r2_token_value

# OpenCode Zen / DeepSeek Clinical Summary API
OPENCODE_ZEN_KEY=your_opencode_zen_api_key
OPENCODE_ZEN_MODEL=deepseek-v4-flash-free
